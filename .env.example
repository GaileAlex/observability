# copy to .env (it is not committed)

# the user admin of Grafana (http://127.0.0.1:3000)
GRAFANA_ADMIN_PASSWORD=

# the alerts go by e-mail: the Gmail account of the application (SPRING_MAIL_USERNAME / SPRING_MAIL_PASSWORD
# of CV/.env, an app password of Google) sends them to ALERT_EMAIL
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# the logs folder of nginx for Windows in front of cv-ui (etc/windows-proxy of CV); C:/nginx/logs when not set
WINDOWS_NGINX_LOGS=
