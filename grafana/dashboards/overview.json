      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client_name) (rate(http_client_requests_seconds_count{application=\"cv\"}[5m])) * 60",
          "legendFormat": "{{client_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
